# Multi-stage build on Red Hat UBI.
# Stage 1 builds with the full toolchain; stage 2 ships only the binary
# and the minimal runtime libs it links against.
#
# Build:
#   podman build -f Containerfile.ubi-multistage -t demo-01-ubi-multistage .

ARG UBI_VERSION=10.2
FROM registry.access.redhat.com/ubi10/ubi:${UBI_VERSION} AS build

# UBI w/o entitlement: silence subscription-manager.
# Free UBI repos in ubi.repo are unaffected — dnf install works normally.
RUN rm -f /etc/yum.repos.d/redhat.repo && \
    sed -i 's/^enabled=1/enabled=0/' \
        /etc/dnf/plugins/subscription-manager.conf 2>/dev/null || true

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake \
        ninja-build \
        git \
    && dnf clean all

WORKDIR /src
COPY src/ ./src/
COPY CMakeLists.txt CMakePresets.json ./

# Release build with LTO. PGO is handled by the dedicated PGO Containerfile.
RUN cmake --preset release \
 && cmake --build --preset release -j"$(nproc)" \
 && strip --strip-all build/release/demo-svc

# ---- runtime stage ----
FROM registry.access.redhat.com/ubi10/ubi-minimal:${UBI_VERSION} AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf

RUN microdnf install -y --setopt=install_weak_deps=0 libstdc++ \
 && microdnf clean all

# Provenance: who built this image, with which toolchain, against which sources.
ARG GIT_SHA=unknown
ARG BUILD_DATE
LABEL org.opencontainers.image.title="cpp-container-tutorial demo-01 ubi-multistage" \
      org.opencontainers.image.description="UBI multi-stage build with LTO" \
      org.opencontainers.image.source="https://github.com/patterncatalyst/cpp-container-optimization-tutorial" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      tutorial.demo="01-image-strategy" \
      tutorial.variant="ubi-multistage" \
      tutorial.toolchain="gcc-14" \
      tutorial.lto="thin"

WORKDIR /app
COPY --from=build /src/build/release/demo-svc /app/demo-svc

USER 1001:1001
EXPOSE 8080
ENTRYPOINT ["/app/demo-svc"]

# statelessness/04-process-scoped-state — composition-root demo.
#
# Same UBI 9 + gRPC scaffold as 02-raii (gRPC + protobuf + abseil, no
# OTel). Simpler than 03-pmr: no AddressSanitizer binary, so no
# libasan-devel. Builds two binaries: state-svc (the service) and
# state-client. First build pulls/compiles the gRPC chain from source;
# with a warm Conan cache from an earlier compendium example it's fast.

FROM registry.access.redhat.com/ubi9/ubi:9.5 AS builder

RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        cmake ninja-build git python3-pip \
        perl-FindBin perl-IPC-Cmd perl-Data-Dumper perl-Pod-Html \
        perl-Pod-Usage perl-File-Compare perl-File-Copy perl-File-Path \
        perl-Time-Piece perl-Getopt-Long perl-Digest-SHA \
        perl-threads perl-threads-shared perl-Thread-Queue \
        perl-Term-ANSIColor \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

ENV PATH="/opt/rh/gcc-toolset-14/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-14/root/usr/lib64"

RUN pip install --quiet "conan~=2.0"

RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.py conan.lock ./
RUN if [ -s conan.lock ]; then \
        echo "==> Using committed conan.lock with --lockfile-partial"; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --lockfile=conan.lock \
                        --lockfile-partial \
                        --build=missing ; \
    else \
        echo "==> conan.lock is empty placeholder; resolving graph fresh"; \
        rm -f conan.lock ; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --build=missing ; \
    fi

COPY src/   ./src/
COPY proto/ ./proto/
COPY CMakeLists.txt ./

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/state-svc \
    && strip --strip-all build/state-client

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++. The gRPC chain is static.
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.5 AS runtime

RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /src/build/state-svc    /usr/local/bin/state-svc
COPY --from=builder /src/build/state-client /usr/local/bin/state-client

# :50051 gRPC StateService, :8080 healthz
EXPOSE 50051 8080

# CACHE_CAPACITY sizes the process-scoped bounded cache. In production
# you size this against the container's cgroup memory limit (Doc 04);
# here it defaults small so the demo evicts visibly.
ENV CACHE_CAPACITY=4

ENTRYPOINT ["/usr/local/bin/state-svc"]

# statelessness/05-threading — CPU-budget detection + pool-sizing demo.
#
# The first compendium example with NO gRPC and NO Conan: it's pure
# standard library plus reading /sys/fs/cgroup, so the build is just a
# C++ compile of two small binaries — seconds, not minutes. No perl set,
# no dependency graph.
#
# Builds:
#   cpu-probe   prints hardware_concurrency() vs the cgroup cpu quota
#   pool-bench  runs a CPU-bound workload across a sized pool and reports
#               throughput + tail latency

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

WORKDIR /src
COPY src/ ./src/
COPY CMakeLists.txt ./

RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/cpu-probe build/pool-bench

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++.
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /src/build/cpu-probe  /usr/local/bin/cpu-probe
COPY --from=builder /src/build/pool-bench /usr/local/bin/pool-bench

# No service, no ports: these are batch binaries the demo runs under
# `podman run --cpus=N` to show the cgroup quota's effect.
# No ENTRYPOINT: this image ships two binaries and the demo selects
# which to run by passing it as the command. CMD (unlike ENTRYPOINT) is
# a default that a passed command REPLACES — `podman run IMG cpu-probe`
# and `podman run IMG pool-bench 2 …` each run the right binary, while a
# bare `podman run IMG` runs the probe.
CMD ["/usr/local/bin/cpu-probe"]

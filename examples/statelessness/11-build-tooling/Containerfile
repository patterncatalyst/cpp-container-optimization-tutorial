# statelessness/11-build-tooling — the vendored-helpers demo.
#
# Builds two binaries from one image:
#   helper-demo    prints what cgroup_helper + psi_reader detect for THIS
#                  process (cpu/memory limit, container detection, PSI).
#   helper-tests   the gtest suite over the helpers' pure parsers.
#
# Dependencies:
#   GoogleTest via Conan (test-only). The helpers + demo use only the
#   standard library and Linux syscalls — no other deps, no system packages.
#
# The build RUNS the gtest suite as a gate (a failing test fails the image
# build), then ships both binaries so the demo can re-run the tests and
# sweep the demo binary under different cgroup caps. The first build
# compiles GoogleTest (~30s); everything else is tiny.

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build python3-pip \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

RUN pip install --quiet "conan~=2.0"

RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.py conan.lock ./
RUN if [ -s conan.lock ]; then \
        conan install . --output-folder=build/conan -s build_type=Release \
                        --lockfile=conan.lock --lockfile-partial --build=missing ; \
    else \
        rm -f conan.lock ; \
        conan install . --output-folder=build/conan -s build_type=Release \
                        --build=missing ; \
    fi

COPY CMakeLists.txt ./
COPY vendor/ ./vendor/
COPY src/    ./src/
COPY tests/  ./tests/

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    # Gate: run the unit tests at build time. A failing parser test fails
    # the image build (the tests are deterministic — no live cgroup needed).
    && ctest --test-dir build --output-on-failure \
    && strip --strip-all build/helper-demo build/helper-tests

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++. Ships BOTH binaries so the demo can
# run the tests and sweep the demo binary under cgroup caps.
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 libstdc++ \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /src/build/helper-demo  /usr/local/bin/helper-demo
COPY --from=builder /src/build/helper-tests /usr/local/bin/helper-tests

CMD ["/usr/local/bin/helper-demo"]

# statelessness/02-raii — RequestContext RAII demo.
#
# A small gRPC service that makes the RequestContext lifecycle visible.
# Lighter than the observability demos: gRPC + protobuf + abseil only,
# no OpenTelemetry. The OTel/gRPC override chain that makes demo-03 and
# demo-04 take 30-45 min on a cold cache is mostly the OTel half; with
# OTel dropped, the cold build is faster (gRPC + protobuf + abseil from
# source under the gnu17 profile). Cached builds: 2-3 min.
#
# Multi-stage: UBI 10 builder (base gcc 14 + Conan), ubi-minimal
# runtime with just libstdc++ and the static binary.

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

# Toolchain + the perl modules protobuf/gRPC's from-source builds want.
# This is demo-03's perl set minus nothing — gRPC's build scripts are
# the consumer, and they're present whether or not OTel is in the graph.
RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build git python3-pip \
        perl-FindBin perl-IPC-Cmd perl-Data-Dumper perl-Pod-Html \
        perl-Pod-Usage perl-File-Compare perl-File-Copy perl-File-Path \
        perl-Time-Piece perl-Getopt-Long perl-Digest-SHA \
        perl-threads perl-threads-shared perl-Thread-Queue \
        perl-Term-ANSIColor \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

RUN pip install --quiet "conan~=2.0"

# Profile detection + cppstd=gnu17 for dependency builds. Our own target
# overrides to C++23 in CMakeLists (the G-27 two-layer pattern).
RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

# Conan install with optional lockfile (the G-31 pattern). A committed,
# non-empty conan.lock is used with --lockfile-partial for reproducible
# resolution; an empty placeholder is removed and the graph resolves
# fresh. To seed a lockfile after a successful build:
#   conan lock create conanfile.py -s build_type=Release \
#       --lockfile-out=conan.lock
COPY conanfile.py conan.lock ./
RUN if [ -s conan.lock ]; then \
        echo "==> Using committed conan.lock with --lockfile-partial"; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --lockfile=conan.lock \
                        --lockfile-partial \
                        --build=missing ; \
    else \
        echo "==> conan.lock is empty placeholder; resolving graph fresh"; \
        rm -f conan.lock ; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --build=missing ; \
    fi

COPY src/   ./src/
COPY proto/ ./proto/
COPY CMakeLists.txt ./

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/raii-svc \
    && strip --strip-all build/raii-client

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal with libstdc++ only. The gRPC chain is static.
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /src/build/raii-svc    /usr/local/bin/raii-svc
COPY --from=builder /src/build/raii-client /usr/local/bin/raii-client

# :50051 gRPC RequestProcessor, :8080 healthz
EXPOSE 50051 8080

ENTRYPOINT ["/usr/local/bin/raii-svc"]

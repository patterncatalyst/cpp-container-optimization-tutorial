# statelessness/07-outbox-pattern — gRPC + PostgreSQL + Kafka.
#
# Builds four binaries from one image:
#   order-svc      gRPC producer (writes order + outbox in one txn)
#   order-client   gRPC client
#   outbox-relay   outbox poller -> Kafka (libpq + librdkafka)
#   order-consumer Kafka -> idempotent projection (libpq + librdkafka)
#
# Dependencies:
#   gRPC + protobuf + abseil   via Conan (the verified G-22..G-30 trio)
#   libpq                      system, UBI AppStream (libpq-devel)
#   librdkafka (C client)      system, EPEL (librdkafka-devel)
#
# librdkafka has no UBI-native package, so EPEL is enabled solely for it
# (a sanctioned exception). We use librdkafka's C API for the same reason
# 07 uses libpq over libpqxx: a stable C ABI, no Conan C++ recipe to
# fight. The first build compiles the gRPC chain (~5 min cold); a warm
# Conan cache makes it far faster.

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

# librdkafka has no el10 package: it is absent from UBI AppStream, from
# the (default-enabled) CodeReady Builder repo, and from EPEL 10 — which
# ships only Python kafka clients, not the C library or its -devel headers
# (the UBI 9 build got librdkafka-devel from EPEL 9, but that package was
# never rebuilt for el10). So EPEL buys us nothing here and librdkafka is
# built from source below (see the librdkafka build step). libpq-devel is
# in UBI AppStream.
RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build git python3-pip \
        pkgconf-pkg-config \
        libpq-devel \
        perl-FindBin perl-IPC-Cmd perl-Data-Dumper perl-Pod-Html \
        perl-Pod-Usage perl-File-Compare perl-File-Copy perl-File-Path \
        perl-Time-Piece perl-Getopt-Long perl-Digest-SHA \
        perl-threads perl-threads-shared perl-Thread-Queue \
        perl-Term-ANSIColor \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

# Build librdkafka (C client) from source, since el10 has no package for
# it. Minimal build: no SSL/SASL/compression (the demo speaks plaintext to
# kafka:9092), producing a lean shared librdkafka.so.1 plus rdkafka.pc.
# CMAKE_INSTALL_LIBDIR=lib keeps the lib and its .pc together under
# /usr/local/lib so pkg-config's -L path matches the installed .so.
ARG LIBRDKAFKA_VERSION=v2.6.1
RUN git clone --depth 1 --branch "${LIBRDKAFKA_VERSION}" \
        https://github.com/confluentinc/librdkafka.git /tmp/librdkafka \
    && cmake -S /tmp/librdkafka -B /tmp/librdkafka/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DRDKAFKA_BUILD_STATIC=OFF \
        -DRDKAFKA_BUILD_EXAMPLES=OFF \
        -DRDKAFKA_BUILD_TESTS=OFF \
        -DWITH_SSL=OFF -DWITH_SASL=OFF -DWITH_ZLIB=OFF \
        -DWITH_ZSTD=OFF -DWITH_CURL=OFF -DENABLE_LZ4_EXT=OFF \
    && cmake --build /tmp/librdkafka/build \
    && cmake --install /tmp/librdkafka/build --prefix /usr/local \
    && rm -rf /tmp/librdkafka

# The project's CMakeLists finds librdkafka via pkg-config (rdkafka.pc);
# point pkg-config at the source-built install under /usr/local/lib.
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig

# Future-proofing: relaxes the cmake_minimum_required floor for any
# Conan-built dep declaring < 3.5 (which CMake 4.x rejects). Honored from
# the environment by CMake 3.31+; harmless to projects already on >= 3.5
# (G-67).
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

RUN pip install --quiet "conan~=2.0"

RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.py conan.lock ./
RUN if [ -s conan.lock ]; then \
        echo "==> Using committed conan.lock with --lockfile-partial"; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --lockfile=conan.lock \
                        --lockfile-partial \
                        --build=missing ; \
    else \
        echo "==> conan.lock is empty placeholder; resolving graph fresh"; \
        rm -f conan.lock ; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --build=missing ; \
    fi

COPY src/   ./src/
COPY proto/ ./proto/
COPY CMakeLists.txt ./

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/order-svc build/order-client \
                         build/outbox-relay build/order-consumer

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++ + libpq + librdkafka (all shared).
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf

# librdkafka has no el10 package, so there is nothing to install for it
# here (EPEL 10 ships no librdkafka); the shared lib built from source in
# the builder stage is copied in below. libpq is in UBI AppStream, so no
# EPEL is needed at runtime.
RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
        libpq \
    && microdnf clean all \
    && rm -rf /var/cache/yum

# librdkafka shared runtime lib (built from source in the builder stage).
# Landing it in /usr/lib64 puts it on the default loader path so the
# relay/consumer binaries resolve librdkafka.so.1 without extra config.
COPY --from=builder /usr/local/lib/librdkafka.so.1 /usr/lib64/librdkafka.so.1

COPY --from=builder /src/build/order-svc      /usr/local/bin/order-svc
COPY --from=builder /src/build/order-client   /usr/local/bin/order-client
COPY --from=builder /src/build/outbox-relay   /usr/local/bin/outbox-relay
COPY --from=builder /src/build/order-consumer /usr/local/bin/order-consumer

# :50051 gRPC OrderService, :8080 healthz (order-svc)
EXPOSE 50051 8080

ENV PG_CONNINFO="postgresql://orders:orders@postgres:5432/orders"
ENV PG_POOL_SIZE=4
ENV KAFKA_BROKERS="kafka:9092"
ENV KAFKA_TOPIC="orders"

# CMD (not ENTRYPOINT): compose selects which binary each service runs by
# passing it as the command (G-66). A bare run starts the producer.
CMD ["/usr/local/bin/order-svc"]

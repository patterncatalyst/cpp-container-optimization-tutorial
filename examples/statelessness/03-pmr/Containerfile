# statelessness/03-pmr — PMR request arena demo.
#
# Same UBI 9 + gRPC scaffold as 02-raii (gRPC + protobuf + abseil, no
# OTel). Builds three binaries:
#   pmr-svc    the gRPC service (arena + bench modes)
#   pmr-client one-shot client
#   pmr-trap   a standalone AddressSanitizer binary demonstrating the
#              lifetime trap; statically linked against libasan so the
#              minimal runtime needs nothing extra to run it
#
# First build pulls/compiles the gRPC chain from source under the gnu17
# Conan profile (a few minutes cold; the same chain 02-raii uses, so a
# warm Conan cache on the host makes this fast). Cached builds: 2-3 min.

FROM registry.access.redhat.com/ubi9/ubi:9.5 AS builder

RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc-toolset-14 \
        cmake ninja-build git python3-pip \
        perl-FindBin perl-IPC-Cmd perl-Data-Dumper perl-Pod-Html \
        perl-Pod-Usage perl-File-Compare perl-File-Copy perl-File-Path \
        perl-Time-Piece perl-Getopt-Long perl-Digest-SHA \
        perl-threads perl-threads-shared perl-Thread-Queue \
        perl-Term-ANSIColor \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

ENV PATH="/opt/rh/gcc-toolset-14/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-14/root/usr/lib64"

RUN pip install --quiet "conan~=2.0"

RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.py conan.lock ./
RUN if [ -s conan.lock ]; then \
        echo "==> Using committed conan.lock with --lockfile-partial"; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --lockfile=conan.lock \
                        --lockfile-partial \
                        --build=missing ; \
    else \
        echo "==> conan.lock is empty placeholder; resolving graph fresh"; \
        rm -f conan.lock ; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --build=missing ; \
    fi

# AddressSanitizer libraries for the pmr-trap binary. Installed as a
# SEPARATE layer AFTER the conan install above so the expensive gRPC-
# chain layer stays cached across rebuilds — changing this line does not
# force the dependency graph to recompile. gcc-toolset-14-libasan-devel
# provides the STATIC ASan library (libasan.a + libasan_preinit.o) that
# -static-libasan needs, so the runtime image needs no sanitizer package.
# (This is the same package demo-07 uses for its sanitizer stage.)
RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc-toolset-14-libasan-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

COPY src/   ./src/
COPY proto/ ./proto/
COPY CMakeLists.txt ./

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/pmr-svc \
    && strip --strip-all build/pmr-client
# NOTE: pmr-trap is intentionally NOT stripped — its whole purpose is a
# readable AddressSanitizer stack trace.

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++. pmr-trap's ASan runtime is static.
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.5 AS runtime

RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /src/build/pmr-svc    /usr/local/bin/pmr-svc
COPY --from=builder /src/build/pmr-client /usr/local/bin/pmr-client
COPY --from=builder /src/build/pmr-trap   /usr/local/bin/pmr-trap

# :50051 gRPC MemoryProcessor, :8080 healthz
EXPOSE 50051 8080

ENTRYPOINT ["/usr/local/bin/pmr-svc"]

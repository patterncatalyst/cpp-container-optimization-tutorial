# statelessness/03-pmr — PMR request arena demo.
#
# Same UBI 10 + gRPC scaffold as 02-raii (gRPC + protobuf + abseil, no
# OTel). Builds three binaries:
#   pmr-svc    the gRPC service (arena + bench modes)
#   pmr-client one-shot client
#   pmr-trap   a standalone AddressSanitizer binary demonstrating the
#              lifetime trap; statically linked against libasan so the
#              minimal runtime needs nothing extra to run it
#
# First build pulls/compiles the gRPC chain from source under the gnu17
# Conan profile (a few minutes cold; the same chain 02-raii uses, so a
# warm Conan cache on the host makes this fast). Cached builds: 2-3 min.

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build git python3-pip \
        perl-FindBin perl-IPC-Cmd perl-Data-Dumper perl-Pod-Html \
        perl-Pod-Usage perl-File-Compare perl-File-Copy perl-File-Path \
        perl-Time-Piece perl-Getopt-Long perl-Digest-SHA \
        perl-threads perl-threads-shared perl-Thread-Queue \
        perl-Term-ANSIColor \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

RUN pip install --quiet "conan~=2.0"

RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.py conan.lock ./
RUN if [ -s conan.lock ]; then \
        echo "==> Using committed conan.lock with --lockfile-partial"; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --lockfile=conan.lock \
                        --lockfile-partial \
                        --build=missing ; \
    else \
        echo "==> conan.lock is empty placeholder; resolving graph fresh"; \
        rm -f conan.lock ; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --build=missing ; \
    fi

# AddressSanitizer libraries for the pmr-trap binary. Installed as a
# SEPARATE layer AFTER the conan install above so the expensive gRPC-
# chain layer stays cached across rebuilds — changing this line does not
# force the dependency graph to recompile.
#
# Ground truth (verified empirically against ubi10/ubi:10.2): the base
# `libasan` package ships ONLY the runtime libasan.so.8[.0.0] — no
# libasan.a. Base gcc/gcc-c++ 14's own private lib dir
# (/usr/lib/gcc/x86_64-redhat-linux/14/) ships a 64-bit libasan.so that
# is just a linker script ("INPUT ( /usr/lib64/libasan.so.8.0.0 )"), and
# NO 64-bit libasan.a — only the 32-bit variant has one. So `-lasan`
# resolves fine for dynamic ASan, but `-static-libasan` fails to find a
# static archive at all ("cannot find -lasan") even with libasan
# installed. The only UBI 10 AppStream package that ships a 64-bit
# libasan.a is gcc-toolset-15-libasan-devel (it pulls in libasan as a
# dep too); it lands under /opt/rh/gcc-toolset-15/, which the base gcc 14
# driver never searches, so copy it into gcc 14's own private lib dir
# where the linker already looks (mirroring how gcc-c++ itself ships the
# 32-bit libasan.a at .../14/32/libasan.a). Statically linking a
# gcc-14-compiled object against the gcc-15 libasan.a works cleanly in
# practice (ASan's runtime ABI is stable across this minor gap) and
# yields a fully static ASan binary — `ldd` shows no libasan.so.8
# dependency — so the runtime image still needs no sanitizer package.
RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc-toolset-15-libasan-devel \
    && cp /opt/rh/gcc-toolset-15/root/usr/lib/gcc/x86_64-redhat-linux/15/libasan.a \
          /usr/lib/gcc/x86_64-redhat-linux/14/libasan.a \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

COPY src/   ./src/
COPY proto/ ./proto/
COPY CMakeLists.txt ./

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/pmr-svc \
    && strip --strip-all build/pmr-client
# NOTE: pmr-trap is intentionally NOT stripped — its whole purpose is a
# readable AddressSanitizer stack trace.

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++. pmr-trap's ASan runtime is static.
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /src/build/pmr-svc    /usr/local/bin/pmr-svc
COPY --from=builder /src/build/pmr-client /usr/local/bin/pmr-client
COPY --from=builder /src/build/pmr-trap   /usr/local/bin/pmr-trap

# :50051 gRPC MemoryProcessor, :8080 healthz
EXPOSE 50051 8080

ENTRYPOINT ["/usr/local/bin/pmr-svc"]

# statelessness/09-health-checks — the gRPC standard health protocol.
#
# Builds two binaries from one image:
#   health-svc     gRPC server: staged startup, HTTP liveness (:8080),
#                  gRPC readiness (:50051), signal-driven readiness toggle,
#                  graceful shutdown.
#   health-probe   our own minimal grpc_health_probe (from proto/health.proto)
#
# Dependencies:
#   gRPC + protobuf + abseil   via Conan (the verified G-22..G-30 trio)
#
# That is the ENTIRE dependency set — no PostgreSQL, no Kafka, no EPEL.
# Liveness is plain HTTP (hand-rolled on a socket), so the only runtime
# extra beyond libstdc++ is `curl`, used by the liveness HEALTHCHECK. The
# first build compiles the gRPC chain (~5 min cold); a warm Conan cache
# makes it far faster.

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

# No EPEL needed — pure gRPC/Conan build. The perl list satisfies gRPC's
# (boringssl's) build scripts (G-30).
RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build git python3-pip \
        pkgconf-pkg-config \
        perl-FindBin perl-IPC-Cmd perl-Data-Dumper perl-Pod-Html \
        perl-Pod-Usage perl-File-Compare perl-File-Copy perl-File-Path \
        perl-Time-Piece perl-Getopt-Long perl-Digest-SHA \
        perl-threads perl-threads-shared perl-Thread-Queue \
        perl-Term-ANSIColor \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

# Relaxes the cmake_minimum_required floor for any Conan-built dep
# declaring < 3.5 (which CMake 4.x rejects). Honored by CMake 3.31+;
# harmless to projects already on >= 3.5 (G-67).
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

RUN pip install --quiet "conan~=2.0"

RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.py conan.lock ./
RUN if [ -s conan.lock ]; then \
        echo "==> Using committed conan.lock with --lockfile-partial"; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --lockfile=conan.lock \
                        --lockfile-partial \
                        --build=missing ; \
    else \
        echo "==> conan.lock is empty placeholder; resolving graph fresh"; \
        rm -f conan.lock ; \
        conan install . --output-folder=build/conan \
                        -s build_type=Release \
                        --build=missing ; \
    fi

COPY src/   ./src/
COPY proto/ ./proto/
COPY CMakeLists.txt ./

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/health-svc build/health-probe

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++. ubi-minimal already ships
# `curl-minimal`, which provides the `curl` command our liveness HEALTHCHECK
# uses — installing full `curl` here would CONFLICT with curl-minimal (both
# provide /usr/bin/curl), so we don't. libstdc++ is the only addition.
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
    && microdnf clean all \
    && rm -rf /var/cache/yum

COPY --from=builder /src/build/health-svc   /usr/local/bin/health-svc
COPY --from=builder /src/build/health-probe /usr/local/bin/health-probe

# :50051 gRPC (Echo + readiness via the standard health service)
# :8080  HTTP liveness (/healthz)
EXPOSE 50051 8080

ENV GRPC_ADDR="0.0.0.0:50051"
ENV HEALTH_HTTP_PORT="8080"

# LIVENESS as the container HEALTHCHECK: the cheap HTTP probe that survives
# gRPC overload. Readiness (the gRPC health service) is queried separately
# by the orchestrator / the demo's health-probe; conflating the two into a
# single restart-driving check is the anti-pattern Doc 09 warns against.
HEALTHCHECK --interval=5s --timeout=2s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8080/healthz || exit 1

CMD ["/usr/local/bin/health-svc"]

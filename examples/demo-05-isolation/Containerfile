ARG UBI_VERSION=10.2

FROM registry.access.redhat.com/ubi10/ubi:${UBI_VERSION} AS build

# UBI w/o entitlement: silence subscription-manager.
# Free UBI repos in ubi.repo are unaffected — dnf install works normally.
RUN rm -f /etc/yum.repos.d/redhat.repo && \
    sed -i 's/^enabled=1/enabled=0/' \
        /etc/dnf/plugins/subscription-manager.conf 2>/dev/null || true

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ cmake ninja-build \
    && dnf clean all

WORKDIR /src
COPY src/ ./src/
COPY CMakeLists.txt ./

ARG HTTPLIB_VERSION=v0.16.0
RUN mkdir -p src/third_party \
 && curl -fsSL -o src/third_party/httplib.h \
        "https://raw.githubusercontent.com/yhirose/cpp-httplib/${HTTPLIB_VERSION}/httplib.h"

RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build -j"$(nproc)" \
 && strip --strip-all build/tenant-a build/tenant-b

# ---- runtime: tenant-a ----
FROM registry.access.redhat.com/ubi10/ubi-minimal:${UBI_VERSION} AS tenant-a
# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 libstdc++ \
 && microdnf clean all
COPY --from=build /src/build/tenant-a /app/tenant-a
LABEL tutorial.demo="05-isolation" tutorial.tenant="a"
EXPOSE 8080
USER 1001:1001
ENTRYPOINT ["/app/tenant-a"]

# ---- runtime: tenant-b ----
FROM registry.access.redhat.com/ubi10/ubi-minimal:${UBI_VERSION} AS tenant-b
# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
# (The older sed on subscription-manager.conf was a no-op: that file
# doesn't exist in ubi-minimal; plugins=0 in dnf.conf is what works.)
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 libstdc++ \
 && microdnf clean all
COPY --from=build /src/build/tenant-b /app/tenant-b
LABEL tutorial.demo="05-isolation" tutorial.tenant="b"
USER 1001:1001
ENTRYPOINT ["/app/tenant-b"]

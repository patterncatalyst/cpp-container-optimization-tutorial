      "fontSize": 13,
      "fontFamily": 2,
      "text": "More threads than quota cannot run in parallel \u2014 they take turns, and the kernel enforces the turns by stalling the whole cgroup.",
      "textAlign": "middle",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "More threads than quota cannot run in parallel \u2014 they take turns, and the kernel enforces the turns by stalling the whole cgroup.",
      "lineHeight": 1.25,
      "autoResize": true
    },
